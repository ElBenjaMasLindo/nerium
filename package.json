{
  "name": "nerium-sdk",
  "description": "Provider-agnostic. Infrastructure-agnostic. Runtime-agnostic. Zero deps for llms calls.",
  "keywords": ["llm", "sdk", "typescript", "provider-agnostic", "multi-provider", "zero-dependencies", "chat", "streaming", "tool-calling"],
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.1",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "gate": "eslint . && tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "sadist": "0.5.3",
    "ts-pattern": "5.7.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "author": "ElBenjaMasLindo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElBenjaMasLindo/nerium.git"
  },
  "bugs": {
    "url": "https://github.com/ElBenjaMasLindo/nerium/issues"
  }
}
